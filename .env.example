# ==============================================================================
# VOXORA - ENVIRONMENT CONFIGURATION TEMPLATE
# Copyright © 2026 Rajveer Sukul. All rights reserved.
# ==============================================================================
# Copy this file to '.env.local' for local development:
#   copy .env.example .env.local
# DO NOT commit your real keys or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE CREDENTIALS ENCRYPTION SECRET
# ------------------------------------------------------------------------------
# Used to encrypt user-supplied API keys with AES-256-GCM.
# Generate a strong 32+ character random string in production.
VOXORA_ENCRYPTION_SECRET=replace_with_a_secure_random_string_in_production_32chars

# ------------------------------------------------------------------------------
# 2. OPENAI API & REALTIME WEBRTC (Primary voice & text engine)
# ------------------------------------------------------------------------------
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# The Realtime speech model (Default: gpt-4o-realtime-preview)
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# ------------------------------------------------------------------------------
# 3. MULTI-PROVIDER AI ADAPTERS (Optional server defaults)
# ------------------------------------------------------------------------------
# Google Gemini API key: https://aistudio.google.com
GEMINI_API_KEY=

# Anthropic Claude API key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Groq LPU API key: https://console.groq.com
GROQ_API_KEY=

# ElevenLabs Voice Synthesis key: https://elevenlabs.io
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# 4. IDENTITY PROVIDERS (OAuth 2.0 Client Credentials)
# ------------------------------------------------------------------------------
# Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord Sign-In
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Apple Sign-In
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Facebook Sign-In
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# OpenAI ChatGPT OAuth
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 5. DEPLOYMENT & HOSTING URL
# ------------------------------------------------------------------------------
# Set to your live production domain with HTTPS: https://voxora.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
